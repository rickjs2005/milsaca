# =================================================================
# @milsaca/web — variáveis de ambiente
# =================================================================
# Copie pra apps/web/.env.local e preencha.
# NUNCA versionar .env.local.

# -------- App --------
# URL pública do site. Em dev: http://localhost:3000
# Em prod: https://milsaca.app (ou domínio escolhido na Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------- Supabase --------
# Project URL — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave publishable (sb_publishable_xxx) — substitui anon key legacy.
# Pode ir pro client; tem permissões limitadas pela RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave secret (sb_secret_xxx) — substitui service_role legacy.
# ⚠️ APENAS NO SERVIDOR. Bypassa RLS. NUNCA expor no client.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# -------- Auth --------
# (vazio por enquanto — confirmação de email, templates, MFA são
# configurados no Supabase Dashboard → Authentication, não em env)

# -------- Email / SMTP --------
# Configurado no Supabase Dashboard → Authentication → SMTP Settings.
# Quando integrar Resend ou outro provider em /api/notifications:
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM=Milsaca <no-reply@milsaca.app>

# -------- WhatsApp --------
# Número de contato do suporte exibido na home pública (formato
# brasileiro completo com DDI 55, só dígitos).
# Ex.: 5533999999999
NEXT_PUBLIC_WHATSAPP_CONTATO=

# Quando integrar WhatsApp Business API (Meta Cloud ou Z-API), futuras:
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# -------- Observabilidade (Sentry) --------
# DSN do projeto Sentry (milsaca-web). Público — pode ir pro client.
# Vazio = Sentry desativado (no-op). Provisionar em https://sentry.io.
NEXT_PUBLIC_SENTRY_DSN=

# Token de build pra upload de sourcemaps (APENAS build-time / CI / Vercel).
# ⚠️ Secret — nunca expor no client. Gerar em Sentry → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=

# Org/projeto Sentry pro upload de sourcemaps (opcional; project default
# = milsaca-web). Só relevantes no build com SENTRY_AUTH_TOKEN.
# SENTRY_ORG=
# SENTRY_PROJECT=milsaca-web

# -------- Analytics --------
# Quando integrar PostHog / Plausible:
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -------- Payments --------
# Quando integrar Asaas / Stripe:
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_SECRET=

# -------- Security --------
# Salt fixo pra hashear IPs em whatsapp_leads (LGPD-friendly).
# Gere com: openssl rand -hex 32
# Sem isso, ip_hash fica null (lead ainda é registrado).
LEAD_IP_SALT=

# -------- Deploy --------
# Variáveis automáticas da Vercel (não preencher):
# VERCEL=1
# VERCEL_ENV=production|preview|development
# VERCEL_URL=<deploy-url>

# ---------------------------------------------------------------
# MapBiomas Alerta (F2 v2 — verificação de desmatamento EUDR)
# Conta gratuita: https://plataforma.alerta.mapbiomas.org/sign-up
# Sem estas vars, o botão "Verificar desmatamento" explica que a
# integração não está configurada (não quebra nada).
# ---------------------------------------------------------------
MAPBIOMAS_ALERTA_EMAIL=
MAPBIOMAS_ALERTA_PASSWORD=
