# =================================================================
# @milsaca/mobile — variáveis de ambiente
# =================================================================
# Copie pra apps/mobile/.env.local e preencha.
# NUNCA versionar .env.local.
#
# Expo expõe apenas vars com prefixo EXPO_PUBLIC_ pro bundle do app.
# Nada secreto pode entrar aqui — o cliente final lê o JS bundle.

# -------- Supabase --------
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# -------- App --------
# URL do site web pra deep links (ex.: links de recuperação de senha
# que abrem o /redefinir-senha).
# EXPO_PUBLIC_SITE_URL=https://milsaca.app
