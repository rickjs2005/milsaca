{
  "expo": {
    "name": "Milsaca",
    "slug": "milsaca",
    "scheme": "milsaca",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2D3A2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.milsaca.app"
    },
    "android": {
      "package": "com.milsaca.app",
      "adaptiveIcon": {
        "backgroundColor": "#2D3A2E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
