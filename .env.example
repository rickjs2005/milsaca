# =================================================================
# Milsaca — Variáveis de ambiente (exemplo)
# Copie para .env.local e preencha. NUNCA versionar .env reais.
# =================================================================

# -------- Supabase (web — Next.js) --------
# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave publishable (sb_publishable_xxx) — substitui a antiga anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave secret (sb_secret_xxx) — substitui a antiga service_role key
# Apenas no servidor. NUNCA expor no cliente.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# -------- Site (web) --------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------- Supabase (mobile — Expo) --------
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# -------- Supabase local (desenvolvimento, opcional) --------
# Preenchido automaticamente após `pnpm db:start`
# SUPABASE_LOCAL_URL=http://127.0.0.1:54321
# SUPABASE_LOCAL_PUBLISHABLE_KEY=
# SUPABASE_LOCAL_SECRET_KEY=
