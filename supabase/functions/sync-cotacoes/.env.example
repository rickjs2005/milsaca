# Edge Function sync-cotacoes — variáveis de ambiente
#
# Setar via:
#   pnpm dlx supabase@latest secrets set CHAVE=valor
#
# Listar atuais:
#   pnpm dlx supabase@latest secrets list

# ---------------------------------------------------------------------------
# Auth interna (obrigatório)
# ---------------------------------------------------------------------------
# Token aleatório que o pg_cron envia no header x-cron-secret pra autorizar a
# chamada. Gere com:
#   $secret = -join ((1..32) | ForEach-Object { [char][int]((65..90)+(97..122)+(48..57) | Get-Random) })
CRON_SECRET=

# ---------------------------------------------------------------------------
# CEPEA — API OFICIAL (opcional; ativa o adapter `cepea_official`)
# ---------------------------------------------------------------------------
# Quando setar essas 2 vars, a edge function passa a usar a API oficial CEPEA
# em vez do scraping de noticiasagricolas.com.br. Sem elas, o scraping continua
# como fallback.
#
# Você recebe esses dados na contratação institucional CEPEA/ESALQ:
# https://www.cepea.esalq.usp.br/br/area-tecnica.aspx
# CEPEA_API_URL=https://api.cepea.esalq.usp.br/v1
# CEPEA_API_TOKEN=

# ID do indicador na API CEPEA. Default: cafe-arabica (Bica Corrida ESALQ).
# CEPEA_INDICATOR=cafe-arabica
